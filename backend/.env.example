# ==============================================================================
# Environment Configuration — Ardena AI Scratch 3 Backend
# ==============================================================================

APP_NAME="Ardena AI Scratch 3"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/ardenaai/backend/public

# ------------------------------------------------------------------------------
# AI Engine: All-in-One Groq Provider
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model Names
GROQ_MODEL_CHAT_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_CHAT_FALLBACK_1=qwen/qwen3.8-27b
GROQ_MODEL_CHAT_FALLBACK_2=openai/gpt-oss-20b
GROQ_MODEL_CHAT_FALLBACK_3=allam-2-7b
GROQ_MODEL_WHISPER=whisper-large-v3
GROQ_MODEL_VISION=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# Firebase Authentication & Firestore Configuration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=ardenaai
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Security & CORS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://localhost:8000
MAX_UPLOAD_SIZE_AUDIO_MB=10
MAX_UPLOAD_SIZE_IMAGE_MB=5
REQUEST_TIMEOUT_SECONDS=30


